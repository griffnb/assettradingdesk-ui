export const {{pascalCase name}}FormModalId = "{{pascalCase name}}FormModal";

interface {{pascalCase name}}FormModalProps {
  record?: {{pascalCase name}}Model;
  newProperties?: { [key: string]: any };
  onSave?: (record: {{pascalCase name}}Model) => void;
}

export const {{pascalCase name}}FormModal = observer(function {{pascalCase name}}FormModal(props: {{pascalCase name}}FormModalProps) {
  const [record, setRecord] = useState<{{pascalCase name}}Model | undefined>(props.record);
  useEffect(() => {
    if (!props.record) {
      const record = Store.{{lowerCase name}}.create(props.newProperties);
      setRecord(record);
    }
  }, [props.record]);

  const onSuccess = () => {
    LayerService.remove({{pascalCase name}}FormModalId);
