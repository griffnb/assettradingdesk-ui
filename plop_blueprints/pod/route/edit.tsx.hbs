import { useAuth } from "@/common_lib/authentication/useAuth";
import { {{pascalCase name}}Edit } from "@/admin/pods/{{lowerCase name}}/pages/{{pascalCase name}}Edit";
import { observer } from "mobx-react";

export default observer(() => {
  const { isAuthenticated, authLoading } = useAuth();
  if (authLoading) {
    return null;
  }

  if (!isAuthenticated) {
    return null;
  }

  return <{{pascalCase name}}Edit />;
});
