import { Store } from "@/models/store/Store";
import { observer } from "mobx-react-lite";
import { useParams } from "react-router";
import { useEffect, useState } from "react";

import { {{pascalCase name}}Form } from "@/admin/pods/{{name}}/components/{{pascalCase name}}Form";
import { {{pascalCase name}}Model } from "@/models/models/{{name}}/model/{{pascalCase name}}Model";
import { AdminTitleBar } from "@/ui/admin/nav/AdminTitleBar";

//interface {{pascalCase name}}EditProps {}

export const {{pascalCase name}}Edit = observer(function {{pascalCase name}}Edit() {
  const [record, setRecord] = useState<{{pascalCase name}}Model | null>(null);
  const params = useParams();
  const { id } = params;

  useEffect(() => {
    if (!id) return;
    Store.{{lowerCase name}}.get(id as string).then(
      (rec) => {
        if(!rec.data) return;
        setRecord(rec.data);
      },
    );
  }, [id]);

  if (!record) return null;

  return (
    <>
      <AdminTitleBar title="Edit {{pascalCase name}}" objectURN={record.urn} />
      <{{pascalCase name}}Form record={record} />
    </>
  );
});
