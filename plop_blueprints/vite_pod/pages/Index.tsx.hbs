import {StandardTableWrap} from "@/ui/common/components/table/StandardTableWrap";
import { AdminTitleBar } from "@/ui/admin/nav/AdminTitleBar";
import { LayerService } from "@/common_lib/services/LayerService";
import {
  {{pascalCase name}}FormModal,
  {{pascalCase name}}FormModalId,
} from "../components/{{pascalCase name}}FormModal";
import { useSearchParams } from "react-router";
import {DefaultMassActions} from "@/ui/common/components/table/nav/DefaultMassActions";
import { MassActionProps } from "@/ui/common/components/types/mass-actions";
import { {{pascalCase name}}Model } from "@/models/models/{{name}}/model/{{pascalCase name}}Model";
import { parseSearchParams, queryToFilters } from "@/utils/query/builder";
import { observer } from "mobx-react-lite";
import { status } from "@/models/models/{{name}}/_constants/status";
import { columns } from "../columns";
import { filters } from "../filters";
import { useMemo } from "react";



export const {{pascalCase name}}Index = observer(function {{pascalCase name}}Index() {
  const [searchParams,setSearchParams] = useSearchParams();

  const appliedFilters = useMemo(
    () =>
      queryToFilters(parseSearchParams(searchParams), {
        status: [],
        limit: "100",
      }),
    [searchParams],
  );
 

  const applyFilters = (params: { [key: string]: string | string[] }) => {
    delete params.reload;
    setSearchParams(params);
  };
  return (
    <>
      <AdminTitleBar title="{{pascalCase pluralName}}" />
      <StandardTableWrap<{{pascalCase name}}Model>
        className="[&_*[data-slot='table-wrap']]:h-[calc(100dvh-var(--warning-bar,0px)-var(--table-footer,0px)-var(--table-nav,0px)-var(--admin-title-bar,0px)-var(--admin-header,0px))] [&_*[data-slot='table-wrap']]:overflow-x-auto"
        newComponent={(tableState) => {
          LayerService.add(
            {{pascalCase name}}FormModalId,
            {{pascalCase name}}FormModal,
            {onSave: () => tableState.reloadData()},
          );
        }}
        columns={columns}
        statuses={status}
        modelType="{{lowerCase name}}"
        filters={filters}
        applyFilters={applyFilters}
        appliedFilters={appliedFilters}
        selectRows={true}
        tableSearch={true}
        tableExport={true}
        hideTotalRow={true}
        infiniteScroll={true}
        massActions={[
          (props) => <DefaultMassActions {...props} />,
        ]}
      />
    </>
  );
});

