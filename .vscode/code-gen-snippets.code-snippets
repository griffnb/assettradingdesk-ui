{
  "css-data-target": {
    "prefix": "[&_*",
    "body": ["[&_*[data-slot='${2:slot-name}']]:"],
  },
  "Constant": {
    "prefix": ["constant"],
    "scope": "",
    "body": [
      "import { IConstant } from \"@/models/types/constants\";",
      "",
      "export const ${1:something}: IConstant[] = [",
      "  {",
      "    id: 0,",
      "    label: \"${2:Label}\",",
      "    icon: \"u u-help-circle\",",
      "    textColor: \" text-text-neutral-tertiary\",",
      "  }",
      "]",
    ],
    "description": "Builds constant body",
  },
  "Switch React": {
    "prefix": "switch-react",
    "body": [
      "{(() => {",
      "switch (${1:placeholder}) {",
      "case 1:",
      "return (<div></div>)",
      "case 2:",
      "return (<div></div>)  ",
      "default:",
      "return (<div></div>)",
      "}",
      "})()}",
    ],
    "description": "React Switch",
  },

  "Row Actions": {
    "prefix": ["column-row-action"],
    "scope": "",
    "body": [
      "render: (options: ColumnComponentOptions<${1:ModelHere}>) => {",
      "return (",
      "<RowActions",
      "{...options}",
      "column={options.column as RowActionColumn<${1:ModelHere}>}",
      ">",
      "{/* Actions before the standard */}",
      "<RowActionsPreActions>",
      "</RowActionsPreActions>",
      "{/* Replaces standard actions */}",
      "<RowActionsActions>",
      "</RowActionsActions>",
      "{/* Actions after the standard */}",
      "<RowActionsPostActions>",
      "</RowActionsPostActions>",
      "</RowActions>",
      ");",
      "},",
      "    ",
    ],
    "description": "Column Row Actions",
  },

  "Link Column": {
    "prefix": "column-link",
    "body": [
      "{",
      "title: \"${1:placeholder}\",",
      "field: \"${1:placeholder}\",",
      "queryField: \"${1:placeholder}\",",
      "linkTo: \"/${2:placeholder}/details/[id]\",",
      "paramMapping: { id: \"id\" },", // {param : record field}
      "render: (options: ColumnComponentOptions<${3:placeholder}Model>) => {",
      "return (",
      "<LinkCell",
      "{...options}",
      "column={options.column as LinkCellColumn<${3:placeholder}Model>}",
      "/>",
      ");",
      "},",
      "} as LinkCellColumn<${3:placeholder}Model>,",
    ],
    "description": "Link Column",
  },

  "Text Edit Column": {
    "prefix": "column-text-edit",
    "body": [
