      "title: \"${1:placeholder}\",",
      "field: \"${1:placeholder}\",",
      "queryField: \"${1:placeholder}\",",
      "type: \"text\",",
      "render: (options: ColumnComponentOptions<${2:placeholder}Model>) => {",
      "return (",
      "<InlineEditCellText",
      "{...options}",
      "column={options.column as InlineEditCellTextColumn<${2:placeholder}Model>}",
      "/>",
      ");",
      "},",
      "} as InlineEditCellTextColumn<${2:placeholder}Model>,",
    ],
    "description": "Inline Edit Cell Column",
  },
  "Multiselect Edit Column": {
    "prefix": "column-multi-select-edit",
