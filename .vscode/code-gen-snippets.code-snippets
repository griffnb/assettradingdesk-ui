  "ConstantsFmt": {
    "prefix": "field-fmt",
    "body": [
      "get ${1:field}Fmt(): string {",
      "if (this.${1:placeholder} !== null) {",
      "const constant = findConstant(constants.${2:model}.${1:placeholder}, this.${1:placeholder});",
      "return constant.label;",
      "}",
      "return \"\";",
      "}",
    ],
  },

  "Dropdown Menu": {
    "prefix": "dropdown",
    "body": [
      "<Menu>",
      "<MenuButton as=\"div\">",
      "<Button",
      "variant=\"primary\"",
      "size=\"sm\"",
      "appendIcon={<i className=\"fa fa-chevron-down\"></i>}",
      ">",
      "Actions",
      "</Button>",
      "</MenuButton>",
      "<MenuItems",
      "transition",
      "anchor=\"bottom end\"",
      "className=\"z-popover mt-1 flex min-w-44 origin-top flex-col items-start rounded-md border border-gray-200 bg-white shadow transition duration-200 ease-out data-[closed]:-translate-y-1 data-[closed]:opacity-0\"",
      ">",
      "<MenuOption onClick={() => {}}>",
      "Sample Action",
      "</MenuOption>",
      "</MenuItems>",
      "</Menu>",
    ],
  },

