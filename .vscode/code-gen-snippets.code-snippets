      "column={options.column as InlineEditCellMultiselectColumn<${3:placeholder}Model>}",
      "/>",
      ");",
      "},",
      "} as InlineEditCellMultiSelectColumn<${3:placeholder}Model>,",
    ],
    "description": "Inline Edit Cell Column",
  },

